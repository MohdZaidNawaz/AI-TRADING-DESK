# Local-only MT5 terminal configuration. Never commit backend/.env.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Valid Phase 9 modes: disabled, read_only, dry_run, live.
# LIVE remains hard-blocked until the Phase 10 execution-safety boundary.
MT5_EXECUTION_MODE=disabled

# Optional backend-only LLM synthesis. Keys remain blank until locally configured.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
FRIDAY_LLM_PROVIDER_MODE=auto
FRIDAY_LLM_DEFAULT_PROVIDER=groq
FRIDAY_LLM_MANUAL_FALLBACK_ENABLED=false
FRIDAY_LLM_TIMEOUT_SECONDS=20
FRIDAY_LLM_MAX_ATTEMPTS=2
FRIDAY_LLM_RETRY_BASE_SECONDS=0.25
FRIDAY_LLM_MAX_RETRY_DELAY_SECONDS=10
FRIDAY_LLM_MAX_OUTPUT_TOKENS=1600

# LLM budget control. Paid calls remain disabled unless explicitly authorized.
FRIDAY_LLM_BUDGET_DB_PATH=runtime/llm_usage.sqlite3
FRIDAY_LLM_MONTHLY_BUDGET_INR=500
FRIDAY_LLM_USABLE_BUDGET_INR=450
FRIDAY_LLM_PROTECTED_RESERVE_INR=50
FRIDAY_LLM_DAILY_LIMIT_INR=25
FRIDAY_LLM_MAX_REQUEST_ESTIMATE_INR=5
FRIDAY_LLM_PAID_PROVIDER_AUTHORIZED=false
FRIDAY_LLM_INR_PER_USD=
# JSON object keyed by provider. Unknown/missing pricing is never treated as free.
FRIDAY_LLM_PROVIDER_PRICING_JSON=
